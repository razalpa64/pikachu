# Optional — cloud persistence for profiles, match results and per-game stats.
# The app runs fully (local relay multiplayer + all solo/AI games) without these.
#
# Use the PUBLISHABLE key (sb_publishable_…) or the legacy anon JWT. Both are
# safe in a browser because every table is protected by Row Level Security.
#
# NEVER set a `sb_secret_…` / service_role key here: Vite inlines VITE_* vars
# into the client bundle, which would publish it to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=          # legacy name, still supported

# Realtime transport: "relay" (bundled authoritative Node server) or "supabase"
VITE_REALTIME_TRANSPORT=relay

# Production relay WebSocket URL for Vercel/cloud hosting (leave blank for local dev proxy)
# Example: wss://pikachu-relay.onrender.com/rt or https://pikachu-relay.onrender.com
VITE_RELAY_URL=

# Relay server port (dev)
RELAY_PORT=8787

# ──────────────────────────────────────────────────────────────
# Admin doctor (server-side only — `npm run admin:doctor`)
# ──────────────────────────────────────────────────────────────
# These are read by a script on your machine, NOT by the browser. They are
# deliberately not prefixed VITE_ so Vite never inlines them into the bundle.
#
# The service key lets the doctor confirm an account's email and write the
# `admin_users` row for `--fix`. Leave it out and the doctor still diagnoses
# everything it can, then prints the SQL to paste.
# SUPABASE_SERVICE_ROLE_KEY=
# Which account to check when you do not pass one on the command line.
# ADMIN_EMAIL=razalpa64@gmail.com


# ──────────────────────────────────────────────────────────────
# Advertising (optional, off by default)
# ──────────────────────────────────────────────────────────────
# The app ships with NO ad SDK and NO publisher id. Google AdSense is only
# loaded after BOTH of these are true:
#
#   1. VITE_ADSENSE_CLIENT holds a real publisher id (`ca-pub-` + 16 digits),
#   2. a visitor presses "Allow ads" on one of the three ad slots.
#
# Until then <AdSlot> renders nothing at all — no reserved box, no script, no
# request to Google. Ad units are placed on the home page footer, below the
# library results and below the feedback form; never inside a game.
#
# The privacy page (/privacy) already describes this behaviour, so if you turn
# ads on, also keep `adsConfigured()` as the single switch — do not hard-code a
# script tag in index.html.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_LIBRARY=
VITE_ADSENSE_SLOT_FEEDBACK=
